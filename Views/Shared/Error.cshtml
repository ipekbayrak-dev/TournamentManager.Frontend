@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
        <div class="text-center" style="max-width: 480px;">

            <div style="font-size: 5rem; line-height: 1; margin-bottom: 1rem;">💀</div>

            <h1 class="fw-bold mb-2" style="color: var(--tm-text); font-size: 2rem;">
                Something Went Wrong
            </h1>

            <p style="color: var(--tm-text-muted); font-size: 0.95rem; line-height: 1.7; margin-bottom: 1.5rem;">
                The server threw a Hex. Try again — if it persists, something deeper is broken.
            </p>

            @if (Model?.ShowRequestId == true)
            {
                <div class="tm-card p-3 mb-4" style="font-family: monospace; font-size: 0.8rem; color: var(--tm-text-muted); text-align: left; word-break: break-all;">
                    <span style="color: var(--tm-gold);">Request ID:</span> @Model.RequestId
                </div>
            }

            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn btn-tm-primary px-4 py-2">
                    Back to Home
                </a>
                <a href="javascript:history.back()" class="btn btn-tm-outline px-4 py-2">
                    Go Back
                </a>
            </div>

        </div>
    </div>
</div>
