@inject Microsoft.Extensions.Configuration.IConfiguration _config
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tournament Manager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm tm-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">⚔ Tournament Manager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Compete">Compete</a>
                        </li>
                        @if (Context.Request.Cookies["AccessToken"] != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Tournament" asp-action="Index">Tournaments</a>
                            </li>
                            @if (Context.Request.Cookies["IsAdmin"] == "true")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index"
                                       style="color: var(--tm-gold);">Admin</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <a class="btn btn-tm-outline btn-sm px-3" asp-controller="Auth" asp-action="Register">Sign up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="tm-footer mt-auto">
        <div class="container text-center">
            <div>&copy; 2026 Tournament Manager</div>
            <div style="margin-top: 0.25rem; font-size: 0.8rem;">
                Looking for the REST API?
                <a href="@_config["ApiSettings:BaseUrl"]" target="_blank"
                   style="color: var(--tm-gold); text-decoration: none; font-weight: 600;">
                    Developer API →
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Confirm modal -->
    <div class="modal fade" id="tmConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content" style="background: var(--tm-surface); border: 1px solid var(--tm-purple-dark); border-radius: 0.75rem;">
                <div class="modal-body p-5 text-center">
                    <div style="font-size: 2.5rem; margin-bottom: 1rem; color: #ff9090;">⚠</div>
                    <p id="tmConfirmMessage" class="fw-semibold mb-4" style="color: var(--tm-text); font-size: 1rem;"></p>
                    <div class="d-flex gap-3 justify-content-center">
                        <button type="button" data-bs-dismiss="modal"
                                style="background: transparent; border: 1px solid var(--tm-purple-dark); color: var(--tm-text-muted);
                                       border-radius: 0.4rem; padding: 0.5rem 1.5rem; cursor: pointer; font-size: 0.9rem;">
                            Cancel
                        </button>
                        <button type="button" id="tmConfirmBtn"
                                style="background: rgba(220,50,50,0.15); border: 1px solid rgba(220,50,50,0.5); color: #ff9090;
                                       border-radius: 0.4rem; padding: 0.5rem 1.5rem; cursor: pointer; font-size: 0.9rem; font-weight: 600;">
                            Confirm
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let _tmPendingForm = null;
        let _tmModal = null;

        function showConfirm(event, message) {
            event.preventDefault();
            _tmPendingForm = event.currentTarget;
            if (!_tmModal) _tmModal = new bootstrap.Modal(document.getElementById('tmConfirmModal'));
            document.getElementById('tmConfirmMessage').textContent = message;
            _tmModal.show();
        }

        document.getElementById('tmConfirmBtn').addEventListener('click', function () {
            _tmModal.hide();
            if (_tmPendingForm) _tmPendingForm.submit();
        });
    </script>
</body>
</html>
