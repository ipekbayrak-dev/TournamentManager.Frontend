@model CreatePlayerRequest
@{
    ViewData["Title"] = "Edit Profile";
    Layout = "_Layout";
    var teams = ViewBag.Teams as List<TeamResponse> ?? new List<TeamResponse>();
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 130px);">
    <div style="width: 100%; max-width: 560px; padding: 1rem;">
        <div class="tm-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div style="font-size: 2.5rem; line-height: 1; margin-bottom: 0.5rem;">✎</div>
                <h2 class="fw-bold mb-1" style="color: var(--tm-text);">Edit your profile</h2>
                <p style="color: var(--tm-text-muted); font-size: 0.9rem; margin: 0;">Fix your details and resubmit for approval</p>
            </div>

            <hr class="tm-divider" />

            @if (ViewData["Error"] != null)
            {
                <div class="alert-tm-error p-3 mb-3 rounded">@ViewData["Error"]</div>
            }

            <form asp-controller="Player" asp-action="EditProfile" method="post">

                <div class="mb-3">
                    <label asp-for="Handle" class="form-label">Handle</label>
                    <input asp-for="Handle" class="form-control" placeholder="Your in-game tag (e.g. s4)" />
                    <span asp-validation-for="Handle" class="text-danger" style="font-size:0.8rem;"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="FirstName" class="form-label">First name</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Ada" />
                        <span asp-validation-for="FirstName" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="LastName" class="form-label">Last name</label>
                        <input asp-for="LastName" class="form-control" placeholder="Lovelace" />
                        <span asp-validation-for="LastName" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="CountryCode" class="form-label">Country code</label>
                        <input asp-for="CountryCode" class="form-control" placeholder="TR" maxlength="2" />
                        <span asp-validation-for="CountryCode" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Position" class="form-label">Position</label>
                        <select asp-for="Position" class="form-select">
                            <option value="">— select —</option>
                            <option value="1">Carry</option>
                            <option value="2">Midlaner</option>
                            <option value="3">Offlaner</option>
                            <option value="4">Soft Support</option>
                            <option value="5">Hard Support</option>
                            <option value="6">Coach</option>
                        </select>
                        <span asp-validation-for="Position" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TeamId" class="form-label">Team</label>
                    <select asp-for="TeamId" class="form-select">
                        <option value="">— select a team —</option>
                        @foreach (var team in teams)
                        {
                            <option value="@team.Id">@team.Name (@team.Handle)</option>
                        }
                    </select>
                    <span asp-validation-for="TeamId" class="text-danger" style="font-size:0.8rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SteamId" class="form-label">Steam ID <span style="color: var(--tm-text-muted); font-size: 0.8rem;">(optional)</span></label>
                    <input asp-for="SteamId" class="form-control" placeholder="76561198..." />
                </div>

                <div class="mb-4 d-flex align-items-center gap-2">
                    <input asp-for="IsCaptain" type="checkbox" class="form-check-input" id="IsCaptain" style="width: 1.1rem; height: 1.1rem; accent-color: var(--tm-purple-light);" />
                    <label for="IsCaptain" class="form-label mb-0" style="cursor: pointer;">I am the team captain</label>
                </div>

                <button type="submit" class="btn btn-tm-primary w-100 py-2">Resubmit for Approval</button>
                <a asp-controller="Player" asp-action="Profile" class="btn w-100 py-2 mt-2"
                   style="background: transparent; color: var(--tm-text-muted); border: 1px solid var(--tm-purple-dark);">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
