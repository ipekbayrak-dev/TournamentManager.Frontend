@model TournamentResponse
@using TournamentManager.Frontend.Models.Match
@using TournamentManager.Frontend.Models.Team
@{
    ViewData["Title"] = Model.Name + " — Bracket";
    Layout = "_Layout";
    var teams = ViewBag.Teams as Dictionary<Guid, TeamResponse> ?? new();
    bool isAdmin = Context.Request.Cookies["IsAdmin"] == "true";

    string TeamName(Guid? id) =>
        id.HasValue && teams.TryGetValue(id.Value, out var t) ? t.Name : "TBD";

    var upperRounds = Model.Matches
        .Where(m => m.BracketType == BracketType.Upper)
        .GroupBy(m => m.RoundNumber)
        .OrderBy(g => g.Key)
        .ToList();

    var lowerRounds = Model.Matches
        .Where(m => m.BracketType == BracketType.Lower)
        .GroupBy(m => m.RoundNumber)
        .OrderBy(g => g.Key)
        .ToList();

    var gf = Model.Matches.FirstOrDefault(m => m.BracketType == BracketType.GrandFinal);

    int ubSlots = upperRounds.FirstOrDefault()?.Count() ?? 1;
    int lbSlots = lowerRounds.FirstOrDefault()?.Count() ?? 1;
    int cardH = 84;
    int cardGap = 14;
    int ubColH = ubSlots * (cardH + cardGap) + cardGap;
    int lbColH = lbSlots * (cardH + cardGap) + cardGap;
}

<style>
    /* ── Layout ── */
    .bk-col {
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        flex-shrink: 0;
        width: 172px;
    }
    .bk-spacer { width: 32px; flex-shrink: 0; }

    /* ── Column round header ── */
    .bk-round-header {
        font-size: 0.57rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--tm-text-muted);
        text-align: center;
        padding-bottom: 8px;
    }

    /* ── Match card ── */
    .bk-card {
        position: relative;
        width: 172px;
        background: var(--tm-surface);
        border: 1px solid rgba(124,58,237,0.22);
        border-radius: 7px;
        overflow: visible;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .bk-card::before {
        content: '';
        position: absolute;
        left: -1px; top: 7px; bottom: 7px;
        width: 3px;
        border-radius: 0 2px 2px 0;
        background: rgba(124,58,237,0.32);
    }
    .bk-card.bk-live::before  { background: #70f070; box-shadow: 0 0 6px rgba(112,240,112,0.45); animation: bk-live-pulse 1.8s ease-in-out infinite; }
    .bk-card.bk-done::before  { background: rgba(201,168,76,0.6); }
    .bk-card:hover            { border-color: rgba(124,58,237,0.42); box-shadow: 0 4px 18px rgba(0,0,0,0.5); }
    .bk-card.bk-done:hover    { border-color: rgba(201,168,76,0.28); }

    /* ── Team rows ── */
    .bk-team {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0.27rem 0.5rem 0.27rem 0.6rem;
        font-size: 0.72rem;
        color: var(--tm-text);
        min-height: 29px;
    }
    .bk-team + .bk-team       { border-top: 1px solid rgba(124,58,237,0.12); }
    .bk-team.bk-winner        { color: var(--tm-gold); font-weight: 700; background: rgba(201,168,76,0.06); }
    .bk-team.bk-tbd           { color: var(--tm-text-muted); font-style: italic; }
    .bk-name                  { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; flex: 1; min-width: 0; }
    .bk-score                 { font-weight: 800; font-size: 0.77rem; min-width: 15px; text-align: right; flex-shrink: 0; color: var(--tm-text); }
    .bk-team.bk-winner .bk-score { color: var(--tm-gold); }

    /* ── Card footer: date + report button ── */
    .bk-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.15rem 0.45rem 0.15rem 0.6rem;
        border-top: 1px solid rgba(124,58,237,0.07);
        gap: 4px;
    }
    .bk-date {
        font-size: 0.53rem;
        color: var(--tm-text-muted);
        letter-spacing: 0.02em;
    }
    .bk-report-btn {
        font-size: 0.52rem !important;
        padding: 0.06rem 0.28rem !important;
        line-height: 1.3;
        opacity: 0;
        transition: opacity 0.15s;
        flex-shrink: 0;
    }
    .bk-card:hover    .bk-report-btn,
    .bk-gf-card:hover .bk-report-btn { opacity: 1; }

    /* ── Section labels ── */
    .bk-section-label {
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: rgba(158,143,191,0.4);
        margin-bottom: 0.35rem;
    }

    /* ── Grand Final card ── */
    .bk-gf-card {
        position: relative;
        width: 172px;
        background: linear-gradient(160deg, rgba(201,168,76,0.07) 0%, rgba(106,13,173,0.1) 100%);
        border: 1px solid rgba(201,168,76,0.26);
        border-radius: 8px;
        box-shadow: 0 0 28px rgba(201,168,76,0.05), inset 0 1px 0 rgba(201,168,76,0.07);
        overflow: visible;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .bk-gf-card::before {
        content: '';
        position: absolute;
        left: -1px; top: 7px; bottom: 7px;
        width: 3px;
        border-radius: 0 2px 2px 0;
        background: rgba(201,168,76,0.55);
    }
    .bk-gf-card .bk-team      { font-size: 0.77rem; min-height: 33px; padding: 0.32rem 0.5rem 0.32rem 0.65rem; }
    .bk-gf-card .bk-team + .bk-team { border-top-color: rgba(201,168,76,0.1); }
    .bk-gf-card .bk-footer    { border-top-color: rgba(201,168,76,0.09); }
    .bk-gf-card:hover          { border-color: rgba(201,168,76,0.48); box-shadow: 0 0 36px rgba(201,168,76,0.1), inset 0 1px 0 rgba(201,168,76,0.1); }

    /* ── Champion row ── */
    .bk-champion {
        font-size: 0.58rem;
        font-weight: 700;
        color: var(--tm-gold);
        text-align: center;
        padding: 0.18rem 0.5rem 0.22rem;
        border-top: 1px solid rgba(201,168,76,0.12);
        letter-spacing: 0.05em;
    }

    /* ── SVG connector ── */
    #connector-svg { position: absolute; top: 0; left: 0; pointer-events: none; overflow: visible; }

    @@keyframes bk-live-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
</style>

<div class="container-fluid py-4" style="max-width: 1600px;">

    <div class="mb-3">
        <a asp-controller="Tournament" asp-action="Detail" asp-route-id="@Model.Slug"
           style="color: var(--tm-text-muted); font-size: 0.85rem; text-decoration: none;">← @Model.Name</a>
    </div>
    <div class="d-flex align-items-center justify-content-between mb-1">
        <h1 class="fw-bold" style="color: var(--tm-text); font-size: 1.4rem; margin: 0;">Bracket</h1>
        <span class="px-3 py-1 rounded-pill fw-semibold" style="font-size: 0.75rem;
            @(Model.Status == TournamentStatus.Completed ? "background: rgba(100,100,100,0.2); color: var(--tm-text-muted);" :
              Model.Status == TournamentStatus.Ongoing    ? "background: rgba(30,120,30,0.2); color: #a0f0a0;" :
              "background: rgba(201,168,76,0.15); color: var(--tm-gold);" )">
            @(Model.Status == TournamentStatus.RegistrationOpen ? "Registration Open" : Model.Status.ToString())
        </span>
    </div>
    <hr class="tm-divider mb-4" />

    @if (!Model.Matches.Any())
    {
        <div class="text-center py-5">
            <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">⚔️</div>
            <p style="color: var(--tm-text-muted);">No matches yet. The bracket will appear once matches are created.</p>
        </div>
    }
    else
    {
        <div style="overflow-x: auto; overflow-y: clip; padding-bottom: 1rem;">
            <div id="bracket-area" style="position: relative; display: flex; flex-direction: row; align-items: stretch; width: max-content;">

                <div style="display: flex; flex-direction: column; gap: 2.5rem;">

                @* ── UPPER BRACKET ── *@
                @if (upperRounds.Any())
                {
                    <div>
                        <div class="bk-section-label">Upper Bracket</div>
                        <div class="d-flex align-items-stretch">
                            @foreach (var round in upperRounds)
                            {
                                <div style="display:flex;flex-direction:column;">
                                    <div class="bk-round-header">UB R@(round.Key)</div>
                                    <div class="bk-col" style="height: @(ubColH)px;">
                                        @foreach (var m in round.OrderBy(x => x.TeamRadiantId?.ToString()))
                                        {
                                            var radWon = m.WinnerTeamId.HasValue && m.WinnerTeamId == m.TeamRadiantId;
                                            var dirWon = m.WinnerTeamId.HasValue && m.WinnerTeamId == m.TeamDireId;
                                            var radTbd = m.TeamRadiantId is null;
                                            var dirTbd = m.TeamDireId is null;
                                            var stClass = m.Status == MatchStatus.Completed ? "bk-done" : m.Status == MatchStatus.InProgress ? "bk-live" : "";
                                            <div class="bk-card @stClass"
                                                 id="bm-@m.Id"
                                                 data-winner-to="@m.WinnerAdvancesToMatchId"
                                                 data-loser-to="@m.LoserAdvancesToMatchId"
                                                 data-bracket="@((int)m.BracketType)">
                                                <div class="bk-team @(radWon ? "bk-winner" : "") @(radTbd ? "bk-tbd" : "")">
                                                    <span class="bk-name">@TeamName(m.TeamRadiantId)</span>
                                                    @if (!radTbd && m.Status != MatchStatus.Scheduled) { <span class="bk-score">@m.TeamRadiantScore</span> }
                                                </div>
                                                <div class="bk-team @(dirWon ? "bk-winner" : "") @(dirTbd ? "bk-tbd" : "")">
                                                    <span class="bk-name">@TeamName(m.TeamDireId)</span>
                                                    @if (!dirTbd && m.Status != MatchStatus.Scheduled) { <span class="bk-score">@m.TeamDireScore</span> }
                                                </div>
                                                <div class="bk-footer">
                                                    <span class="bk-date">@m.ScheduledAt.ToString("MMM d")</span>
                                                    @if (isAdmin)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-tm-outline bk-report-btn"
                                                                data-match-id="@m.Id"
                                                                data-slug="@Model.Slug"
                                                                data-radiant-id="@(m.TeamRadiantId?.ToString()??"")"
                                                                data-radiant-name="@Html.Encode(TeamName(m.TeamRadiantId))"
                                                                data-dire-id="@(m.TeamDireId?.ToString()??"")"
                                                                data-dire-name="@Html.Encode(TeamName(m.TeamDireId))"
                                                                data-radiant-score="@m.TeamRadiantScore"
                                                                data-dire-score="@m.TeamDireScore"
                                                                data-status="@m.Status"
                                                                data-winner-id="@(m.WinnerTeamId?.ToString()??"")"
                                                                >✎</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="bk-spacer"></div>
                            }

                        </div>
                    </div>
                }

                @* ── LOWER BRACKET ── *@
                @if (lowerRounds.Any())
                {
                    <div>
                        <div class="bk-section-label">Lower Bracket</div>
                        <div class="d-flex align-items-stretch">
                            @foreach (var round in lowerRounds)
                            {
                                <div style="display:flex;flex-direction:column;">
                                    <div class="bk-round-header">LB R@(round.Key)</div>
                                    <div class="bk-col" style="height: @(lbColH)px;">
                                        @foreach (var m in round.OrderBy(x => x.TeamRadiantId?.ToString()))
                                        {
                                            var radWon = m.WinnerTeamId.HasValue && m.WinnerTeamId == m.TeamRadiantId;
                                            var dirWon = m.WinnerTeamId.HasValue && m.WinnerTeamId == m.TeamDireId;
                                            var radTbd = m.TeamRadiantId is null;
                                            var dirTbd = m.TeamDireId is null;
                                            var stClass = m.Status == MatchStatus.Completed ? "bk-done" : m.Status == MatchStatus.InProgress ? "bk-live" : "";
                                            <div class="bk-card @stClass"
                                                 id="bm-@m.Id"
                                                 data-winner-to="@m.WinnerAdvancesToMatchId"
                                                 data-loser-to="@m.LoserAdvancesToMatchId"
                                                 data-bracket="@((int)m.BracketType)">
                                                <div class="bk-team @(radWon ? "bk-winner" : "") @(radTbd ? "bk-tbd" : "")">
                                                    <span class="bk-name">@TeamName(m.TeamRadiantId)</span>
                                                    @if (!radTbd && m.Status != MatchStatus.Scheduled) { <span class="bk-score">@m.TeamRadiantScore</span> }
                                                </div>
                                                <div class="bk-team @(dirWon ? "bk-winner" : "") @(dirTbd ? "bk-tbd" : "")">
                                                    <span class="bk-name">@TeamName(m.TeamDireId)</span>
                                                    @if (!dirTbd && m.Status != MatchStatus.Scheduled) { <span class="bk-score">@m.TeamDireScore</span> }
                                                </div>
                                                <div class="bk-footer">
                                                    <span class="bk-date">@m.ScheduledAt.ToString("MMM d")</span>
                                                    @if (isAdmin)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-tm-outline bk-report-btn"
                                                                data-match-id="@m.Id"
                                                                data-slug="@Model.Slug"
                                                                data-radiant-id="@(m.TeamRadiantId?.ToString()??"")"
                                                                data-radiant-name="@Html.Encode(TeamName(m.TeamRadiantId))"
                                                                data-dire-id="@(m.TeamDireId?.ToString()??"")"
                                                                data-dire-name="@Html.Encode(TeamName(m.TeamDireId))"
                                                                data-radiant-score="@m.TeamRadiantScore"
                                                                data-dire-score="@m.TeamDireScore"
                                                                data-status="@m.Status"
                                                                data-winner-id="@(m.WinnerTeamId?.ToString()??"")"
                                                                >✎</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="bk-spacer"></div>
                            }
                        </div>
                    </div>
                }

                </div>@* end UB+LB column wrapper *@

                @* ── GRAND FINAL (right column, centered vertically) ── *@
                @if (gf is not null)
                {
                    var gfRadWon = gf.WinnerTeamId.HasValue && gf.WinnerTeamId == gf.TeamRadiantId;
                    var gfDirWon = gf.WinnerTeamId.HasValue && gf.WinnerTeamId == gf.TeamDireId;
                    <div style="display: flex; align-items: center; flex-shrink: 0; padding-left: 32px;">
                        <div>
                            <div class="bk-section-label" style="text-align: center; color: var(--tm-gold);">Grand Final</div>
                            <div class="bk-gf-card" id="bm-@gf.Id"
                                 data-winner-to="" data-loser-to="" data-bracket="3">
                                <div class="bk-team @(gfRadWon ? "bk-winner" : "") @(gf.TeamRadiantId is null ? "bk-tbd" : "")">
                                    <span class="bk-name">@TeamName(gf.TeamRadiantId)</span>
                                    @if (gf.TeamRadiantId is not null && gf.Status != MatchStatus.Scheduled) { <span class="bk-score">@gf.TeamRadiantScore</span> }
                                </div>
                                <div class="bk-team @(gfDirWon ? "bk-winner" : "") @(gf.TeamDireId is null ? "bk-tbd" : "")">
                                    <span class="bk-name">@TeamName(gf.TeamDireId)</span>
                                    @if (gf.TeamDireId is not null && gf.Status != MatchStatus.Scheduled) { <span class="bk-score">@gf.TeamDireScore</span> }
                                </div>
                                @if (gf.WinnerTeamId.HasValue && teams.TryGetValue(gf.WinnerTeamId.Value, out var champ))
                                {
                                    <div class="bk-champion">🏆 @champ.Name</div>
                                }
                                else
                                {
                                    <div class="bk-footer">
                                        <span class="bk-date">@gf.ScheduledAt.ToString("MMM d")</span>
                                        @if (isAdmin)
                                        {
                                            <button type="button" class="btn btn-sm btn-tm-outline bk-report-btn"
                                                    data-match-id="@gf.Id"
                                                    data-slug="@Model.Slug"
                                                    data-radiant-id="@(gf.TeamRadiantId?.ToString()??"")"
                                                    data-radiant-name="@Html.Encode(TeamName(gf.TeamRadiantId))"
                                                    data-dire-id="@(gf.TeamDireId?.ToString()??"")"
                                                    data-dire-name="@Html.Encode(TeamName(gf.TeamDireId))"
                                                    data-radiant-score="@gf.TeamRadiantScore"
                                                    data-dire-score="@gf.TeamDireScore"
                                                    data-status="@gf.Status"
                                                    data-winner-id="@(gf.WinnerTeamId?.ToString()??"")"
                                                    >✎</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <svg id="connector-svg" width="1" height="1" overflow="visible"></svg>
            </div>
        </div>
    }
</div>

@* ── Report Match Modal (admin only) ── *@
@if (isAdmin)
{
    <div class="modal fade" id="reportMatchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
            <div class="modal-content" style="background: var(--tm-surface); border: 1px solid var(--tm-purple-dark); border-radius: 0.75rem;">
                <div class="modal-body p-4">
                    <h5 class="fw-bold mb-4" style="color: var(--tm-text);">Report Match Result</h5>
                    <form method="post" asp-controller="Admin" asp-action="ReportMatch">
                        <input type="hidden" name="returnTo" value="bracket" />
                        <input type="hidden" id="rm-id" name="Id" />
                        <input type="hidden" id="rm-slug" name="slug" />
                        <div class="row g-3 mb-3">
                            <div class="col-5">
                                <label class="form-label" id="rm-radiant-label">Radiant</label>
                                <input type="number" class="form-control tm-input" id="rm-radiant-score" name="TeamRadiantScore" min="0" value="0" />
                            </div>
                            <div class="col-2 d-flex align-items-end justify-content-center pb-2" style="color: var(--tm-text-muted); font-weight: 700;">–</div>
                            <div class="col-5">
                                <label class="form-label" id="rm-dire-label">Dire</label>
                                <input type="number" class="form-control tm-input" id="rm-dire-score" name="TeamDireScore" min="0" value="0" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Winner</label>
                            <select class="form-select tm-input" id="rm-winner" name="WinnerTeamId">
                                <option value="">— TBD —</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select class="form-select tm-input" id="rm-status" name="Status">
                                <option value="1">Scheduled</option>
                                <option value="2">In Progress</option>
                                <option value="3">Completed</option>
                                <option value="4">Cancelled</option>
                                <option value="5">Forfeited</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Completed At</label>
                            <input type="datetime-local" class="form-control tm-input" id="rm-completed-at" name="CompletedAt" />
                        </div>
                        <div class="d-flex gap-3 justify-content-end">
                            <button type="button" data-bs-dismiss="modal"
                                    style="background: transparent; border: 1px solid var(--tm-purple-dark); color: var(--tm-text-muted);
                                           border-radius: 0.4rem; padding: 0.5rem 1.5rem; cursor: pointer; font-size: 0.9rem;">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-tm-primary px-4">Save Result</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<script>
    // ── Connector lines ──
    function drawConnectors() {
        const area = document.getElementById('bracket-area');
        const svg  = document.getElementById('connector-svg');
        if (!area || !svg) return;

        const aRect = area.getBoundingClientRect();
        // Use offsetWidth/Height for reliable sizing; SVG overflow="visible" handles any overflow
        svg.setAttribute('width',  area.offsetWidth  || aRect.width  || 1);
        svg.setAttribute('height', area.offsetHeight || aRect.height || 1);
        svg.innerHTML = '';

        function midY(el) {
            const r = el.getBoundingClientRect();
            return r.top + r.height / 2 - aRect.top;
        }
        function rightX(el) { return el.getBoundingClientRect().right - aRect.left; }
        function leftX(el)  { return el.getBoundingClientRect().left  - aRect.left; }

        function addBracketLine(x1, y1, x2, y2) {
            const stubX = x1 + 16;
            const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            p.setAttribute('d', `M ${x1} ${y1} H ${stubX} V ${y2} H ${x2}`);
            p.setAttribute('stroke', '#7c3aed');
            p.setAttribute('stroke-width', '1.5');
            p.setAttribute('fill', 'none');
            p.setAttribute('stroke-opacity', '0.65');
            svg.appendChild(p);
        }

        document.querySelectorAll('[data-winner-to]').forEach(card => {
            const wId = card.dataset.winnerTo;
            if (!wId || wId === '' || wId === 'undefined') return;
            const target = document.getElementById('bm-' + wId);
            if (!target) return;
            addBracketLine(rightX(card), midY(card), leftX(target), midY(target));
        });
    }

    // Double rAF ensures layout is fully flushed before we measure positions
    function scheduleConnectors() {
        requestAnimationFrame(() => requestAnimationFrame(drawConnectors));
    }
    window.addEventListener('load', scheduleConnectors);
    window.addEventListener('resize', scheduleConnectors);

    // ── Report modal ──
    let _rmModal = null;
    function openReportModal(matchId, slug, radiantId, radiantName, direId, direName, radiantScore, direScore, status, winnerId) {
        document.getElementById('rm-id').value   = matchId;
        document.getElementById('rm-slug').value = slug;
        document.getElementById('rm-radiant-label').textContent = radiantName;
        document.getElementById('rm-dire-label').textContent    = direName;
        document.getElementById('rm-radiant-score').value = radiantScore;
        document.getElementById('rm-dire-score').value    = direScore;

        const statusMap = { Scheduled: '1', InProgress: '2', Completed: '3', Cancelled: '4', Forfeited: '5' };
        document.getElementById('rm-status').value = statusMap[status] || '1';

        const w = document.getElementById('rm-winner');
        w.innerHTML = '<option value="">— TBD —</option>';
        if (radiantId) w.innerHTML += `<option value="${radiantId}">${radiantName}</option>`;
        if (direId)    w.innerHTML += `<option value="${direId}">${direName}</option>`;
        w.value = winnerId || '';

        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        document.getElementById('rm-completed-at').value = now.toISOString().slice(0, 16);

        if (!_rmModal) _rmModal = new bootstrap.Modal(document.getElementById('reportMatchModal'));
        _rmModal.show();
    }

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.bk-report-btn');
        if (!btn) return;
        const d = btn.dataset;
        openReportModal(d.matchId, d.slug, d.radiantId, d.radiantName, d.direId, d.direName,
            d.radiantScore, d.direScore, d.status, d.winnerId);
    });
</script>
