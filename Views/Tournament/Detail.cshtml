@model TournamentResponse
@using TournamentManager.Frontend.Models.Team
@using TournamentManager.Frontend.Models.Match
@using TournamentManager.Frontend.Models.TournamentEntry
@using TournamentManager.Frontend.Models.Player
@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";
    var teams = ViewBag.Teams as Dictionary<Guid, TeamResponse> ?? new();
    var playerProfile = ViewBag.PlayerProfile as PlayerResponse;
    var alreadyRegistered = playerProfile != null
        && playerProfile.TeamId != Guid.Empty
        && Model.Entries.Any(e => e.TeamId == playerProfile.TeamId);

    string StatusBg(TournamentStatus s) => s switch {
        TournamentStatus.Ongoing          => "background: rgba(30,120,30,0.2); color: #a0f0a0;",
        TournamentStatus.RegistrationOpen => "background: rgba(201,168,76,0.2); color: var(--tm-gold);",
        TournamentStatus.Upcoming         => "background: rgba(106,13,173,0.2); color: #c9a0f0;",
        TournamentStatus.Completed        => "background: rgba(100,100,100,0.2); color: var(--tm-text-muted);",
        _                                 => "background: rgba(180,30,30,0.2); color: #f5a0a0;"
    };
    string StatusLabel(TournamentStatus s) => s switch {
        TournamentStatus.RegistrationOpen => "Registration Open",
        _ => s.ToString()
    };
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-controller="Tournament" asp-action="Index"
           style="color: var(--tm-text-muted); font-size: 0.85rem; text-decoration: none;">
            ← All Tournaments
        </a>
    </div>

    <div class="tm-card p-4 p-md-5 mb-4">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
            <h1 class="fw-bold mb-0" style="color: var(--tm-text); font-size: clamp(1.5rem, 4vw, 2.2rem);">@Model.Name</h1>
            <span class="px-3 py-1 rounded-pill fw-semibold" style="font-size: 0.8rem; @StatusBg(Model.Status)">
                @StatusLabel(Model.Status)
            </span>
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p style="color: var(--tm-text-muted); font-size: 0.95rem; max-width: 680px; margin-bottom: 1.5rem;">@Model.Description</p>
        }

        <div class="d-flex flex-wrap gap-4">
            @if (!string.IsNullOrEmpty(Model.Location))
            {
                <div>
                    <div style="color: var(--tm-text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Location</div>
                    <div style="color: var(--tm-text); font-weight: 600;">📍 @Model.Location</div>
                </div>
            }
            <div>
                <div style="color: var(--tm-text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Start Date</div>
                <div style="color: var(--tm-text); font-weight: 600;">@Model.StartDate.ToString("MMMM dd, yyyy")</div>
            </div>
            <div>
                <div style="color: var(--tm-text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">End Date</div>
                <div style="color: var(--tm-text); font-weight: 600;">@Model.EndDate.ToString("MMMM dd, yyyy")</div>
            </div>
            <div>
                <div style="color: var(--tm-text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Teams</div>
                <div style="color: var(--tm-text); font-weight: 600;">@Model.Entries.Count registered</div>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mt-3 p-3 rounded" style="background: rgba(220,50,50,0.15); color: #ff9090; font-size: 0.875rem;">
                @TempData["Error"]
            </div>
        }

        @if (Model.Status == TournamentStatus.RegistrationOpen)
        {
            <hr class="tm-divider mt-4" />
            if (alreadyRegistered)
            {
                var entry = Model.Entries.First(e => e.TeamId == playerProfile!.TeamId);
                <div class="d-flex align-items-center gap-3 mt-3">
                    <p class="mb-0" style="color: var(--tm-gold); font-size: 0.9rem;">✓ Your team is registered for this tournament.</p>
                    <form asp-controller="Tournament" asp-action="WithdrawTeam" method="post"
                          onsubmit="showConfirm(event, 'Withdraw your team from this tournament? This cannot be undone.');">
                        <input type="hidden" name="entryId" value="@entry.Id" />
                        <input type="hidden" name="slug" value="@Model.Slug" />
                        <button type="submit" class="btn btn-sm"
                                style="border: 1px solid rgba(220,50,50,0.5); color: #ff9090;">
                            Withdraw
                        </button>
                    </form>
                </div>
            }
            else if (playerProfile is null)
            {
                <p class="mb-0 mt-3" style="color: var(--tm-text-muted); font-size: 0.875rem;">Create a player profile to register your team for this tournament.</p>
            }
            else if (playerProfile.Status != PlayerStatus.Approved)
            {
                <p class="mb-0 mt-3" style="color: var(--tm-text-muted); font-size: 0.875rem;">Your player profile must be approved before you can register.</p>
            }
            else if (playerProfile.TeamId == Guid.Empty)
            {
                <p class="mb-0 mt-3" style="color: var(--tm-text-muted); font-size: 0.875rem;">You must be assigned to a team before you can register.</p>
            }
            else if (!playerProfile.IsCaptain)
            {
                <p class="mb-0 mt-3" style="color: var(--tm-text-muted); font-size: 0.875rem;">Only the team captain can register for tournaments.</p>
            }
            else
            {
                <form asp-controller="Tournament" asp-action="RegisterTeam" method="post" class="mt-3">
                    <input type="hidden" name="tournamentId" value="@Model.Id" />
                    <input type="hidden" name="teamId" value="@playerProfile.TeamId" />
                    <input type="hidden" name="slug" value="@Model.Slug" />
                    <input type="hidden" name="tournamentName" value="@Model.Name" />
                    <button type="submit" class="btn btn-tm-primary px-4 py-2">
                        Register My Team →
                    </button>
                </form>
            }
        }
    </div>

    <div class="mb-4">
        <h2 class="fw-bold mb-3" style="color: var(--tm-text); font-size: 1.2rem;">
            Registered Teams
            <span style="color: var(--tm-text-muted); font-size: 0.85rem; font-weight: 400; margin-left: 0.5rem;">@Model.Entries.Count</span>
        </h2>
        <hr class="tm-divider" />

        @if (Model.Entries.Count == 0)
        {
            <div class="text-center py-5">
                <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🛡️</div>
                <p style="color: var(--tm-text-muted);">No warriors have answered the call yet.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var entry in Model.Entries.OrderBy(e => e.Seed))
                {
                    var team = teams.GetValueOrDefault(entry.TeamId);
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <a asp-controller="Team" asp-action="Detail" asp-route-id="@entry.TeamId"
                           style="text-decoration: none;"
                           onmouseover="this.querySelector('.tm-card').style.borderColor='var(--tm-gold)'"
                           onmouseout="this.querySelector('.tm-card').style.borderColor=''">
                            <div class="tm-card p-3 d-flex align-items-center gap-3" style="transition: border-color 0.15s; cursor: pointer;">
                                @if (team is not null && !string.IsNullOrEmpty(team.Logo))
                                {
                                    <img src="@team.Logo" alt="@team.Name"
                                         style="width: 40px; height: 40px; object-fit: contain; flex-shrink: 0;"
                                         onerror="this.style.display='none'" />
                                }
                                <div class="overflow-hidden">
                                    <div class="fw-semibold text-truncate" style="color: var(--tm-text); font-size: 0.9rem;">
                                        @(team?.Name ?? "Unknown Team")
                                    </div>
                                    <div style="color: var(--tm-text-muted); font-size: 0.75rem;">
                                        @@@(team?.Handle ?? "")
                                        @if (entry.Seed.HasValue)
                                        {
                                            <span style="margin-left: 0.4rem; color: var(--tm-gold);">Seed @entry.Seed</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    <div>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="fw-bold mb-0" style="color: var(--tm-text); font-size: 1.2rem;">
                Matches
                <span style="color: var(--tm-text-muted); font-size: 0.85rem; font-weight: 400; margin-left: 0.5rem;">@Model.Matches.Count</span>
            </h2>
            @if (Model.Matches.Count > 0)
            {
                <a asp-controller="Tournament" asp-action="Bracket" asp-route-id="@Model.Slug"
                   style="color: var(--tm-gold); font-size: 0.85rem; text-decoration: none; font-weight: 600;">
                    View Bracket →
                </a>
            }
        </div>
        <hr class="tm-divider" />

        @if (Model.Matches.Count == 0)
        {
            <div class="text-center py-5">
                <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">⚔️</div>
                <p style="color: var(--tm-text-muted);">The bracket awaits. Matches will appear once the tournament begins.</p>
            </div>
        }
        else
        {
            <div class="tm-card table-responsive">
                <table class="table mb-0" style="color: var(--tm-text); --bs-table-color: var(--tm-text); --bs-table-bg: transparent; --bs-table-border-color: var(--tm-purple-dark); --bs-table-striped-color: var(--tm-text); --bs-table-hover-color: var(--tm-text);">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--tm-gold); font-size: 0.85rem; color: var(--tm-text-muted);">
                            <th>Round</th>
                            <th>Bracket</th>
                            <th>Radiant</th>
                            <th class="text-center">Score</th>
                            <th>Dire</th>
                            <th>Scheduled</th>
                            <th>Status</th>
                            @if (Context.Request.Cookies["IsAdmin"] == "true") { <th></th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var match in Model.Matches.OrderBy(m => m.ScheduledAt).ThenBy(m => m.BracketType == BracketType.GrandFinal ? 99 : (int)m.BracketType))
                        {
                            var radiant = match.TeamRadiantId.HasValue ? teams.GetValueOrDefault(match.TeamRadiantId.Value) : null;
                            var dire    = match.TeamDireId.HasValue    ? teams.GetValueOrDefault(match.TeamDireId.Value)    : null;
                            <tr style="border-color: var(--tm-purple-dark);">
                                <td>R@(match.RoundNumber)</td>
                                <td style="font-size: 0.8rem; color: var(--tm-text-muted);">
                                    @(match.BracketType switch {
                                        BracketType.Upper      => "Upper",
                                        BracketType.Lower      => "Lower",
                                        BracketType.GrandFinal => "Grand Final",
                                        _ => match.BracketType.ToString()
                                    })
                                </td>
                                <td class="fw-semibold">@(radiant?.Name ?? "TBD")</td>
                                <td class="text-center fw-bold" style="color: var(--tm-gold);">
                                    @(match.Status == MatchStatus.Scheduled ? "vs" : $"{match.TeamRadiantScore} – {match.TeamDireScore}")
                                </td>
                                <td class="fw-semibold">@(dire?.Name ?? "TBD")</td>
                                <td style="font-size: 0.8rem; color: var(--tm-text-muted);">@match.ScheduledAt.ToString("MMM dd, HH:mm")</td>
                                <td>
                                    <span class="px-2 py-1 rounded-pill" style="font-size: 0.7rem; font-weight: 700;
                                        @(match.Status == MatchStatus.Completed ? "background: rgba(100,100,100,0.2); color: var(--tm-text-muted);" :
                                          match.Status == MatchStatus.InProgress ? "background: rgba(30,180,30,0.3); color: #70f070;"              :
                                          "background: rgba(106,13,173,0.2); color: #c9a0f0;")">
                                        @match.Status
                                    </span>
                                </td>
                                @if (Context.Request.Cookies["IsAdmin"] == "true")
                                {
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-tm-outline"
                                                onclick="showReportMatch('@match.Id', '@Model.Slug',
                                                    '@(match.TeamRadiantId?.ToString() ?? "")', '@(radiant?.Name ?? "TBD")',
                                                    '@(match.TeamDireId?.ToString() ?? "")', '@(dire?.Name ?? "TBD")',
                                                    @match.TeamRadiantScore, @match.TeamDireScore, '@match.Status',
                                                    '@(match.WinnerTeamId?.ToString() ?? "")')">
                                            Report
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@if (Context.Request.Cookies["IsAdmin"] == "true")
{
    <div class="modal fade" id="reportMatchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
            <div class="modal-content" style="background: var(--tm-surface); border: 1px solid var(--tm-purple-dark); border-radius: 0.75rem;">
                <div class="modal-body p-4">
                    <h5 class="fw-bold mb-4" style="color: var(--tm-text);">Report Match Result</h5>
                    <form method="post" asp-controller="Admin" asp-action="ReportMatch">
                        <input type="hidden" name="returnTo" value="detail" />
                        <input type="hidden" id="rm-id" name="Id" />
                        <input type="hidden" id="rm-slug" name="slug" />

                        <div class="row g-3 mb-3">
                            <div class="col-5">
                                <label class="form-label" id="rm-radiant-label">Radiant</label>
                                <input type="number" class="form-control tm-input" id="rm-radiant-score" name="TeamRadiantScore" min="0" value="0" />
                            </div>
                            <div class="col-2 d-flex align-items-end justify-content-center pb-2" style="color: var(--tm-text-muted); font-weight: 700;">–</div>
                            <div class="col-5">
                                <label class="form-label" id="rm-dire-label">Dire</label>
                                <input type="number" class="form-control tm-input" id="rm-dire-score" name="TeamDireScore" min="0" value="0" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Winner</label>
                            <select class="form-select tm-input" id="rm-winner" name="WinnerTeamId">
                                <option value="">— TBD —</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <select class="form-select tm-input" id="rm-status" name="Status">
                                <option value="1">Scheduled</option>
                                <option value="2">In Progress</option>
                                <option value="3">Completed</option>
                                <option value="4">Cancelled</option>
                                <option value="5">Forfeited</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Completed At</label>
                            <input type="datetime-local" class="form-control tm-input" id="rm-completed-at" name="CompletedAt" />
                        </div>

                        <div class="d-flex gap-3 justify-content-end">
                            <button type="button" data-bs-dismiss="modal"
                                    style="background: transparent; border: 1px solid var(--tm-purple-dark); color: var(--tm-text-muted);
                                           border-radius: 0.4rem; padding: 0.5rem 1.5rem; cursor: pointer; font-size: 0.9rem;">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-tm-primary px-4">Save Result</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        let _rmModal = null;
        function showReportMatch(matchId, slug, radiantId, radiantName, direId, direName, radiantScore, direScore, status, winnerId) {
            document.getElementById('rm-id').value = matchId;
            document.getElementById('rm-slug').value = slug;
            document.getElementById('rm-radiant-label').textContent = radiantName;
            document.getElementById('rm-dire-label').textContent = direName;
            document.getElementById('rm-radiant-score').value = radiantScore;
            document.getElementById('rm-dire-score').value = direScore;

            const statusMap = { 'Scheduled': '1', 'InProgress': '2', 'Completed': '3', 'Cancelled': '4', 'Forfeited': '5' };
            document.getElementById('rm-status').value = statusMap[status] || '1';

            const winner = document.getElementById('rm-winner');
            winner.innerHTML = '<option value="">— TBD —</option>';
            if (radiantId) winner.innerHTML += `<option value="${radiantId}">${radiantName}</option>`;
            if (direId)    winner.innerHTML += `<option value="${direId}">${direName}</option>`;
            winner.value = winnerId || '';

            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('rm-completed-at').value = now.toISOString().slice(0, 16);

            if (!_rmModal) _rmModal = new bootstrap.Modal(document.getElementById('reportMatchModal'));
            _rmModal.show();
        }
    </script>
}
