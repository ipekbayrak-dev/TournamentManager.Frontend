@model List<TournamentResponse>
@{
    ViewData["Title"] = "Tournaments";
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color: var(--tm-text);">Tournaments</h1>
            <p style="color: var(--tm-text-muted); margin: 0;">@Model?.Count tournament(s) available</p>
        </div>
    </div>

    <hr class="tm-divider" />

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5">
            <div style="font-size: 3rem; margin-bottom: 1rem;">⚔</div>
            <p style="color: var(--tm-text-muted);">No tournaments yet. Check back soon.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var t in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="tm-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="fw-bold mb-0" style="color: var(--tm-text);">@t.Name</h5>
                            <span class="ms-2 px-2 py-1 rounded-pill" style="font-size: 0.7rem; font-weight: 600; white-space: nowrap;
                                @(t.Status == TournamentStatus.Ongoing ? "background: rgba(30,120,30,0.2); color: #a0f0a0;" :
                                  t.Status == TournamentStatus.RegistrationOpen ? "background: rgba(201,168,76,0.2); color: var(--tm-gold);" :
                                  t.Status == TournamentStatus.Upcoming ? "background: rgba(106,13,173,0.2); color: #c9a0f0;" :
                                  t.Status == TournamentStatus.Completed ? "background: rgba(100,100,100,0.2); color: var(--tm-text-muted);" :
                                  "background: rgba(180,30,30,0.2); color: #f5a0a0;")">
                                @(t.Status switch {
                                    TournamentStatus.RegistrationOpen => "Registration Open",
                                    _ => t.Status.ToString()
                                })
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(t.Description))
                        {
                            <p style="color: var(--tm-text-muted); font-size: 0.875rem; margin-bottom: 1rem;">@t.Description</p>
                        }

                        <div class="mt-auto">
                            @if (!string.IsNullOrEmpty(t.Location))
                            {
                                <p style="color: var(--tm-text-muted); font-size: 0.8rem; margin-bottom: 0.4rem;">
                                    📍 @t.Location
                                </p>
                            }
                            <p style="color: var(--tm-text-muted); font-size: 0.8rem; margin-bottom: 0.4rem;">
                                📅 @t.StartDate.ToString("MMM dd, yyyy") → @t.EndDate.ToString("MMM dd, yyyy")
                            </p>

                            <hr class="tm-divider" style="margin: 0.75rem 0;" />

                            <a asp-controller="Tournament" asp-action="Detail" asp-route-id="@t.Id"
                               class="btn btn-tm-primary w-100 py-2" style="font-size: 0.875rem;">
                                View Tournament →
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
