@model List<TournamentResponse>
@{
    ViewData["Title"] = "Tournaments";
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold mb-1" style="color: var(--tm-text);">Tournaments</h1>
            <p style="color: var(--tm-text-muted); margin: 0;" id="resultCount">@Model?.Count tournament(s) available</p>
        </div>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="d-flex flex-wrap gap-3 mb-4 align-items-center">
            <input type="text" id="searchInput" placeholder="Search by name or location..."
                   style="background: var(--tm-surface); border: 1px solid var(--tm-purple-dark); color: var(--tm-text);
                          border-radius: 0.5rem; padding: 0.5rem 1rem; font-size: 0.875rem; outline: none; max-width: 280px; width: 100%;"
                   oninput="applyFilters()" />
            <div class="d-flex gap-2 flex-wrap" id="statusFilters">
                <button class="filter-btn active" data-status="all" onclick="setStatus(this)">All</button>
                <button class="filter-btn" data-status="RegistrationOpen" onclick="setStatus(this)">Registration Open</button>
                <button class="filter-btn" data-status="Ongoing" onclick="setStatus(this)">Ongoing</button>
                <button class="filter-btn" data-status="Upcoming" onclick="setStatus(this)">Upcoming</button>
                <button class="filter-btn" data-status="Completed" onclick="setStatus(this)">Completed</button>
            </div>
        </div>
    }

    <hr class="tm-divider" />

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5">
            <div style="font-size: 3rem; margin-bottom: 1rem;">⚔</div>
            <p style="color: var(--tm-text-muted);">The battlefield is quiet. No tournaments have been declared yet.</p>
        </div>
    }
    else
    {
        <div class="row g-4" id="tournamentGrid">
            @foreach (var t in Model)
            {
                <div class="col-md-6 col-lg-4 tournament-card"
                     data-name="@t.Name.ToLower()"
                     data-location="@(t.Location?.ToLower() ?? "")"
                     data-status="@t.Status.ToString()">
                    <div class="tm-card p-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="fw-bold mb-0" style="color: var(--tm-text);">@t.Name</h5>
                            <span class="ms-2 px-2 py-1 rounded-pill" style="font-size: 0.7rem; font-weight: 600; white-space: nowrap;
                                @(t.Status == TournamentStatus.Ongoing ? "background: rgba(30,120,30,0.2); color: #a0f0a0;" :
                                  t.Status == TournamentStatus.RegistrationOpen ? "background: rgba(201,168,76,0.2); color: var(--tm-gold);" :
                                  t.Status == TournamentStatus.Upcoming ? "background: rgba(106,13,173,0.2); color: #c9a0f0;" :
                                  t.Status == TournamentStatus.Completed ? "background: rgba(100,100,100,0.2); color: var(--tm-text-muted);" :
                                  "background: rgba(180,30,30,0.2); color: #f5a0a0;")">
                                @(t.Status switch {
                                    TournamentStatus.RegistrationOpen => "Registration Open",
                                    _ => t.Status.ToString()
                                })
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(t.Description))
                        {
                            <p style="color: var(--tm-text-muted); font-size: 0.875rem; margin-bottom: 1rem;">@t.Description</p>
                        }

                        <div class="mt-auto">
                            @if (!string.IsNullOrEmpty(t.Location))
                            {
                                <p style="color: var(--tm-text-muted); font-size: 0.8rem; margin-bottom: 0.4rem;">
                                    📍 @t.Location
                                </p>
                            }
                            <p style="color: var(--tm-text-muted); font-size: 0.8rem; margin-bottom: 0.4rem;">
                                📅 @t.StartDate.ToString("MMM dd, yyyy") → @t.EndDate.ToString("MMM dd, yyyy")
                            </p>

                            <hr class="tm-divider" style="margin: 0.75rem 0;" />

                            <a asp-controller="Tournament" asp-action="Detail" asp-route-id="@t.Slug"
                               class="btn btn-tm-primary w-100 py-2" style="font-size: 0.875rem;">
                                View Tournament →
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div id="emptyFilter" class="text-center py-5" style="display: none;">
            <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🔍</div>
            <p style="color: var(--tm-text-muted);">No tournaments match — try a different search or filter.</p>
        </div>
    }
</div>

<style>
    .filter-btn {
        background: var(--tm-surface);
        border: 1px solid var(--tm-purple-dark);
        color: var(--tm-text-muted);
        border-radius: 999px;
        padding: 0.35rem 0.9rem;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
    }
    .filter-btn:hover {
        border-color: var(--tm-gold);
        color: var(--tm-gold);
    }
    .filter-btn.active {
        background: rgba(201,168,76,0.15);
        border-color: var(--tm-gold);
        color: var(--tm-gold);
    }
    #searchInput:focus {
        border-color: var(--tm-gold);
        box-shadow: 0 0 0 2px rgba(201,168,76,0.15);
    }
</style>

<script>
    let activeStatus = 'all';

    function setStatus(btn) {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeStatus = btn.dataset.status;
        applyFilters();
    }

    function applyFilters() {
        const query = document.getElementById('searchInput').value.toLowerCase().trim();
        const cards = document.querySelectorAll('.tournament-card');
        let visible = 0;

        cards.forEach(card => {
            const matchesSearch = !query
                || card.dataset.name.includes(query)
                || card.dataset.location.includes(query);
            const matchesStatus = activeStatus === 'all' || card.dataset.status === activeStatus;
            const show = matchesSearch && matchesStatus;
            card.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        document.getElementById('resultCount').textContent = visible + ' tournament(s) available';
        document.getElementById('emptyFilter').style.display = visible === 0 ? '' : 'none';
    }
</script>
