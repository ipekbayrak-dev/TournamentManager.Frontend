@model List<TeamResponse>
@{
    ViewData["Title"] = "Manage Teams";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="fw-bold mb-1" style="color: var(--tm-text);">Teams</h1>
            <p style="color: var(--tm-text-muted); margin: 0;">@Model?.Count team(s) in the system</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateTeam" class="btn btn-tm-primary px-4 py-2">
            + Create New
        </a>
    </div>

    <hr class="tm-divider" />

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5">
            <div style="font-size: 3rem; margin-bottom: 1rem;">🛡</div>
            <p style="color: var(--tm-text-muted);">No teams yet.</p>
            <a asp-controller="Admin" asp-action="CreateTeam" class="btn btn-tm-primary px-4 py-2">Create the first one</a>
        </div>
    }
    else
    {
        <div class="tm-card table-responsive">
            <table class="table mb-0" style="color: var(--tm-text); --bs-table-bg: transparent; --bs-table-color: var(--tm-text); --bs-table-border-color: var(--tm-purple-dark);">
                <thead>
                    <tr style="border-color: var(--tm-purple-dark); color: var(--tm-text); font-size: 0.85rem; border-bottom: 1px solid var(--tm-gold);">
                        <th>Logo</th>
                        <th>Name</th>
                        <th>Handle</th>
                        <th>Region</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr style="border-color: var(--tm-purple-dark);">
                            <td>
                                @if (!string.IsNullOrEmpty(t.Logo))
                                {
                                    <img src="@t.Logo" alt="@t.Handle" style="width: 32px; height: 32px; object-fit: contain; border-radius: 4px;" />
                                }
                                else
                                {
                                    <span style="color: var(--tm-text-muted);">—</span>
                                }
                            </td>
                            <td class="fw-semibold">@t.Name</td>
                            <td style="color: var(--tm-text);">@t.Handle</td>
                            <td>
                                <span class="px-2 py-1 rounded-pill" style="font-size: 0.7rem; font-weight: 700; background: rgba(140,60,220,0.3); color: #d0a0ff;">
                                    @t.Region
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Admin" asp-action="EditTeam" asp-route-id="@t.Id"
                                   class="btn btn-sm btn-tm-outline me-1">Edit</a>
                                <form asp-controller="Admin" asp-action="DeleteTeam" method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Delete @t.Name? This cannot be undone.');">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-sm"
                                            style="border: 1px solid rgba(220,50,50,0.5); color: #ff9090;">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
