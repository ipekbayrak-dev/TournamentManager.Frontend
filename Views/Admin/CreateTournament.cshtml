@model CreateTournamentRequest
@{
    ViewData["Title"] = "Create Tournament";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-controller="Admin" asp-action="Tournaments" style="color: var(--tm-text-muted); text-decoration: none; font-size: 0.875rem;">
            ← Back to Tournaments
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="tm-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div style="font-size: 2.5rem; line-height: 1; margin-bottom: 0.5rem;">⚔</div>
                    <h2 class="fw-bold mb-1" style="color: var(--tm-text);">Create Tournament</h2>
                    <p style="color: var(--tm-text-muted); font-size: 0.9rem; margin: 0;">Fill in the tournament details</p>
                </div>

                <hr class="tm-divider" />

                @if (ViewData["Error"] != null)
                {
                    <div class="alert-tm-error p-3 mb-3 rounded">@ViewData["Error"]</div>
                }

                <form asp-controller="Admin" asp-action="CreateTournament" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Tournament name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. The International" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label">Slug <span style="color: var(--tm-text-muted); font-size: 0.8rem;">used in URL</span></label>
                        <input asp-for="Slug" class="form-control" placeholder="e.g. the-international-2026" />
                        <span asp-validation-for="Slug" class="text-danger" style="font-size:0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description <span style="color: var(--tm-text-muted); font-size: 0.8rem;">(optional)</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of the tournament..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label">Location <span style="color: var(--tm-text-muted); font-size: 0.8rem;">(optional)</span></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Istanbul, Turkey" />
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label asp-for="StartDate" class="form-label">Start date</label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="EndDate" class="form-label">End date</label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger" style="font-size:0.8rem;"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-tm-primary w-100 py-2">Create Tournament</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
