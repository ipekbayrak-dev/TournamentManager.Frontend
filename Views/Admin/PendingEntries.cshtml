@model List<PendingEntryViewModel>
@using TournamentManager.Frontend.Models.TournamentEntry
@{
    ViewData["Title"] = "Pending Entries";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold mb-1" style="color: var(--tm-text);">Pending Entries</h1>
        <p style="color: var(--tm-text-muted); margin: 0;">@Model?.Count team(s) awaiting tournament approval</p>
    </div>

    <hr class="tm-divider" />

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5">
            <div style="font-size: 3rem; margin-bottom: 1rem;">✓</div>
            <p style="color: var(--tm-text-muted);">No pending entries — all caught up.</p>
        </div>
    }
    else
    {
        <div class="tm-card table-responsive">
            <table class="table mb-0" style="color: var(--tm-text); --bs-table-bg: transparent; --bs-table-color: var(--tm-text); --bs-table-border-color: var(--tm-purple-dark);">
                <thead>
                    <tr style="color: var(--tm-text); font-size: 0.85rem; border-bottom: 1px solid var(--tm-gold);">
                        <th>Team</th>
                        <th>Tournament</th>
                        <th>Seed</th>
                        <th>Registered</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr style="border-color: var(--tm-purple-dark);">
                            <td class="fw-semibold">@e.TeamName</td>
                            <td style="color: var(--tm-text-muted);">@e.TournamentName</td>
                            <td>@(e.Seed.HasValue ? $"#{e.Seed}" : "—")</td>
                            <td style="color: var(--tm-text-muted); font-size: 0.85rem;">@e.RegisteredAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end d-flex gap-2 justify-content-end align-items-center flex-wrap">
                                <form asp-controller="Admin" asp-action="ApproveEntry" method="post" class="d-flex align-items-center gap-1">
                                    <input type="hidden" name="id" value="@e.Id" />
                                    <input type="number" name="seed" value="@e.Seed" min="1" max="8" required
                                           style="width: 60px; background: rgba(255,255,255,0.05); border: 1px solid rgba(201,168,76,0.4); color: var(--tm-text); border-radius: 4px; padding: 2px 6px; font-size: 0.8rem;"
                                           title="Seed" />
                                    <button type="submit" class="btn btn-sm"
                                            style="background: rgba(30,180,30,0.2); color: #70f070; border: 1px solid rgba(30,180,30,0.4);">
                                        Approve
                                    </button>
                                </form>
                                <form asp-controller="Admin" asp-action="RejectEntry" method="post"
                                      onsubmit="showConfirm(event, 'Reject @e.TeamName from @e.TournamentName?');">
                                    <input type="hidden" name="id" value="@e.Id" />
                                    <input type="hidden" name="seed" value="@e.Seed" />
                                    <button type="submit" class="btn btn-sm"
                                            style="background: rgba(220,50,50,0.2); color: #ff9090; border: 1px solid rgba(220,50,50,0.4);">
                                        Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
